# Copy this file to .env and fill in a real key for local `vercel dev` testing.
# In production, set this in your Vercel project's Environment Variables instead —
# never commit the real key.
ANTHROPIC_API_KEY=sk-ant-...

# The deployed site's exact origin (scheme + host, no trailing slash), e.g.
# https://akrisht.dev. api/ask.js rejects requests whose Origin header
# doesn't match this. Leave unset locally — the check is skipped when this
# var is empty, so `vercel dev`/localhost keeps working without it. Set it
# in Vercel's Environment Variables for the production deployment.
ALLOWED_ORIGIN=
